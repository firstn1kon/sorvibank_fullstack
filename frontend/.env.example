# Куда vite-прокси (server.proxy в vite.config.ts) шлёт запросы /api в dev-режиме.
# Не нужен, если backend поднят локально на дефолтном порту 4000.
VITE_PROXY_TARGET=http://localhost:4000

# Абсолютный API URL для собранного билда — нужен, только если фронт и бэк
# разнесены по разным доменам. В докере (nginx проксирует /api на backend) не задаётся.
# VITE_API_URL=https://api.example.com/api
